# Variables del modo público (hosting). NO subas un .env real al repositorio.
IDI_PUBLICO=1
IDI_ADMIN_USER=admin
IDI_ADMIN_PASS=cambia-esta-clave-larga      # mínimo 10 caracteres; solo se usa al crear la base
IDI_SECRET=una-cadena-aleatoria-de-32-o-mas-caracteres
IDI_HTTPS=1
